{
  "rules": {
    "hm_chat": {
      "messages": {
        ".read": true,
        ".write": true,
        "$msgId": {
          ".validate": "newData.hasChildren(['uuid','nickname','color','text','ts'])"
        }
      },
      "typing": {
        ".read": true,
        ".write": true
      },
      "online": {
        ".read": true,
        ".write": true
      }
    }
  }
}
