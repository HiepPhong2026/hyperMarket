{
  "rules": {
    "users": {
      "$uid": {
        ".read":  "auth !== null && auth.uid === $uid",
        ".write": "auth !== null && auth.uid === $uid"
      }
    },
    "hm_chat": {
      "messages": {
        ".read": true,
        ".write": true,
        "$msgId": {
          ".validate": "newData.hasChildren(['uuid','nickname','color','text','ts'])"
        }
      },
      "typing": {
        ".read": true,
        ".write": true
      },
      "online": {
        ".read": true,
        ".write": true
      }
    }
  }
}
