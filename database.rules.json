{
  "rules": {
    "hm": {
      "chat": {
        "messages": {
          ".read": true,
          ".write": true,
          "$msgId": {
            ".validate": "newData.hasChildren(['uuid','nickname','color','text','ts'])"
          }
        },
        "typing": {
          ".read": true,
          ".write": true
        },
        "online": {
          ".read": true,
          ".write": true
        }
      }
    },
    "hugqr_saved": {
      "$deviceId": {
        ".read": true,
        ".write": true,
        "$entry": {
          ".validate": "newData.hasChildren(['bankCode','bankBin','accountNo','accountName','savedAt'])"
        }
      }
    }
  }
}
